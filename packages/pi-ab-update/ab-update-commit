#!/bin/bash
# pi-ab-update: commit a tryboot candidate only after it has been continuously
# healthy. Separate from the installer so a candidate that never reaches
# userspace simply remains uncommitted and falls back on the next reset.
#
# Board-agnostic. The health predicate is data plus one optional hook: every
# unit in AB_HEALTH_UNITS must be active with no restarts, /data must be
# mounted rw, this must be a tryboot candidate boot, and AB_HEALTH_HOOK (if
# configured) must exit 0. A touchscreen product points that hook at its
# first-frame marker; a headless one points it at whatever proves its service
# is really working, or omits it.
set -euo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

ab_config=${AB_UPDATE_CONFIG:-/usr/lib/pi-ab-update/ab-update.conf}

ab_config_value() { # $1=key; empty when absent
    [ -f "$ab_config" ] && [ ! -L "$ab_config" ] || return 0
    awk -v key="$1" '
        /^[[:space:]]*#/ { next }
        index($0, key "=") == 1 {
            value = substr($0, length(key) + 2)
            if (value != "") { print value; found = 1 }
        }
        END { exit !found }
    ' "$ab_config" 2>/dev/null || true
}
ab_setting() { # $1=env value, $2=config key, $3=default
    if [ -n "$1" ]; then printf '%s\n' "$1"; return; fi
    local configured; configured=$(ab_config_value "$2")
    if [ -n "$configured" ]; then printf '%s\n' "$configured"; return; fi
    printf '%s\n' "$3"
}

selector=$(ab_setting "${AB_SLOT_SELECTOR:-}" AB_SLOT_SELECTOR /usr/local/sbin/ab-slot-selector)
state_dir=$(ab_setting "${AB_STATE_DIR:-}" AB_STATE_DIR /data/pi-ab-update)
state_file=${AB_STATE_FILE:-$state_dir/update-state}
status_dir=$(ab_setting "${AB_RUNTIME_DIR:-}" AB_RUNTIME_DIR /run/ab-update)
status_file=${AB_STATUS_FILE:-$status_dir/status}
health_units=$(ab_setting "${AB_HEALTH_UNITS:-}" AB_HEALTH_UNITS '')
health_hook=$(ab_setting "${AB_HEALTH_HOOK:-}" AB_HEALTH_HOOK '')
data_mount=$(ab_setting "${AB_DATA_MOUNT:-}" AB_DATA_MOUNT /data)
tryboot_marker=${AB_TRYBOOT_MARKER:-/proc/device-tree/chosen/bootloader/tryboot}
settle_seconds=$(ab_setting "${AB_SETTLE_SECONDS:-}" AB_SETTLE_SECONDS 30)
wait_seconds=$(ab_setting "${AB_COMMIT_WAIT_SECONDS:-}" AB_COMMIT_WAIT_SECONDS 120)
# What a refused candidate boot does next: reboot (default) or stay up for
# inspection (a bench setting). See give_up.
on_refusal=$(ab_setting "${AB_ON_REFUSAL:-}" AB_ON_REFUSAL reboot)
# Same fixed-command seam as the installer's; fixtures never reboot the host.
reboot_command=${AB_REBOOT_COMMAND:-/usr/sbin/reboot}
# Why the last candidate was refused, for the fallback that follows. A file of
# its own, not a key in update-state: after the refusal the committed slot
# boots, and an older image's commit helper parses update-state strictly
# (exactly four keys) - an extra key would make it ignore the state and never
# record the fallback. Root-only, like update-state.
refusal_file=${AB_REFUSAL_FILE:-$state_dir/update-refusal}

die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

# Elapsed time must never come from the wall clock here. An appliance with no
# RTC boots in the past and jumps forward when NTP syncs - and a factory reset
# makes that jump larger, because the wipe removes the saved clock state. A
# forward jump mid-operation would otherwise look like minutes of elapsed time
# that never happened. /proc/uptime is monotonic and needs no external time
# source at all, which is also what a permanently offline device requires.
monotonic_seconds() { awk '{ printf "%d\n", $1 }' /proc/uptime; }

is_positive_integer() { [[ ${1:-} =~ ^[1-9][0-9]*$ ]]; }

load_state() {
    local line key value
    declare -gA update_state=()
    while IFS= read -r line || [ -n "$line" ]; do
        [[ $line =~ ^(state|candidate_slot|version|variant)=([^=[:space:]]+)$ ]] || return 1
        key=${line%%=*}; value=${line#*=}
        [ -z "${update_state[$key]+present}" ] || return 1
        update_state[$key]=$value
    done < "$state_file"
    [ "${#update_state[@]}" -eq 4 ] || return 1
    case "${update_state[state]}" in candidate-armed|committed|fallback) ;; *) return 1 ;; esac
    case "${update_state[candidate_slot]}" in A|B) ;; *) return 1 ;; esac
    [[ ${update_state[version]} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || return 1
    [[ ${update_state[variant]} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || return 1
}

is_tryboot_candidate() {
    [ -r "$tryboot_marker" ] || return 1
    od -An -tu1 "$tryboot_marker" | awk '{ for (i = 1; i <= NF; ++i) if ($i != 0) found = 1 } END { exit !found }'
}

data_is_writable() {
    [ "$(findmnt -rn -T "$state_dir" -o TARGET 2>/dev/null || true)" = "$data_mount" ] || return 1
    findmnt -rn -T "$state_dir" -o OPTIONS | grep -Eq '(^|,)rw(,|$)'
}

# One restart of a health unit during the candidate window means the candidate
# is not healthy, even if it happens to be active again by the time we look.
restart_counts() {
    local unit count output=""
    for unit in $health_units; do
        count=$(systemctl show --value --property=NRestarts "$unit" 2>/dev/null) || return 1
        [[ $count =~ ^[0-9]+$ ]] || return 1
        output="$output$unit=$count "
    done
    printf '%s\n' "$output"
}

# Why the candidate is not healthy right now, in words, for the journal: the
# first predicate that fails. Mirrors candidate_is_healthy.
health_failure() { # $1=restart counts at the start of the window
    local expected_restarts=${1:-} unit now
    for unit in $health_units; do
        systemctl is-active --quiet "$unit" || { printf 'health unit %s is not active\n' "$unit"; return; }
    done
    data_is_writable || { printf '%s is not mounted read-write\n' "$data_mount"; return; }
    if [ -n "$health_hook" ]; then
        [ -x "$health_hook" ] || { printf 'health hook %s is not executable\n' "$health_hook"; return; }
        "$health_hook" >/dev/null 2>&1 || { printf 'health hook %s failed\n' "$health_hook"; return; }
    fi
    now=$(restart_counts 2>/dev/null || printf 'unreadable')
    if [ -n "$expected_restarts" ] && [ "$now" != "$expected_restarts" ]; then
        printf 'a health unit restarted (%s-> %s)\n' "$expected_restarts" "$now"
        return
    fi
    printf 'no predicate failed on re-check (transient)\n'
}

# The recorded reason is one line of printable text, bounded, so no reader
# ever has to defend against it.
record_refusal() { # $1=reason
    local reason temporary
    reason=$(printf '%s' "$1" | tr -c '[:print:]' ' ' | cut -c1-200)
    data_is_writable || return 1
    temporary=$(mktemp "$state_dir/.update-refusal.XXXXXX") || return 1
    {
        printf 'version=%s\n' "${update_state[version]}"
        printf 'candidate_slot=%s\n' "${update_state[candidate_slot]}"
        printf 'refused_reason=%s\n' "$reason"
    } > "$temporary"
    chmod 0600 "$temporary"
    sync -f "$temporary"
    mv -f "$temporary" "$refusal_file"
    sync -f "$state_dir"
}

# The reason recorded for the candidate this state is about; nothing for any
# other (a stale record from an earlier candidate is not this one's).
refusal_reason() {
    [ -f "$refusal_file" ] && [ ! -L "$refusal_file" ] || return 1
    [ "$(awk -F= '$1 == "version" { print substr($0, 9); exit }' "$refusal_file")" = "${update_state[version]}" ] || return 1
    [ "$(awk -F= '$1 == "candidate_slot" { print substr($0, 16); exit }' "$refusal_file")" = "${update_state[candidate_slot]}" ] || return 1
    awk -F= '$1 == "refused_reason" { print substr($0, 16); found = 1; exit } END { exit !found }' "$refusal_file"
}

# Every way out of a candidate boot without a commit says why, once - and a
# refused candidate does not keep running. The service has judged it not
# acceptable; left up, it stays uncommitted and nothing records the fallback
# or tells the operator until some later reboot happens to roll it back
# (found on the bench: 7 minutes and counting). The tryboot flag is one-shot,
# so a plain reboot boots the committed slot, whose commit service then records
# `fallback` (the normal-slot rule) with this reason alongside.
# AB_ON_REFUSAL=stay keeps a refused candidate up for inspection.
give_up() {
    printf '[INFO] not committing candidate slot %s: %s\n' "${update_state[candidate_slot]}" "$*"
    record_refusal "$*" || printf '%s\n' '[WARN] could not record the refusal reason' >&2
    if [ "$on_refusal" = reboot ] && is_tryboot_candidate; then
        printf '[INFO] rebooting to the committed slot (AB_ON_REFUSAL=reboot)\n'
        sync
        "$reboot_command" || printf '[ERROR] reboot failed (%s); the candidate stays up until the next reboot\n' "$reboot_command" >&2
    fi
    exit 0
}

candidate_is_healthy() {
    local expected_restarts=${1:-} unit
    for unit in $health_units; do
        systemctl is-active --quiet "$unit" || return 1
    done
    data_is_writable || return 1
    if [ -n "$health_hook" ]; then
        [ -x "$health_hook" ] || return 1
        "$health_hook" >/dev/null 2>&1 || return 1
    fi
    [ -z "$expected_restarts" ] || [ "$(restart_counts)" = "$expected_restarts" ]
}

write_update_state() { # $1=state
    local new_state=$1 temporary
    temporary=$(mktemp "$state_dir/.update-state.XXXXXX")
    {
        printf 'state=%s\n' "$new_state"
        printf 'candidate_slot=%s\n' "${update_state[candidate_slot]}"
        printf 'version=%s\n' "${update_state[version]}"
        printf 'variant=%s\n' "${update_state[variant]}"
    } > "$temporary"
    chmod 0600 "$temporary"
    sync -f "$temporary"
    mv -f "$temporary" "$state_file"
    sync -f "$state_dir"
}

# The durable state remains root-only authority.  This separate, bounded file
# is UI telemetry only, so the unprivileged HMI can show committed/pending or
# fallback truthfully without gaining access to update control state.
# state= stays first; version= and candidate_slot= name the candidate the state
# is about, so a UI can say which release fell back without its own record.
# refused_reason= follows on a fallback whose candidate the service refused
# (a candidate that never reached the service - a boot that hung, a power
# cut - has none).
publish_status() { # $1=committed|candidate-armed|fallback
    local public_state=$1 temporary reason
    install -d -m0755 "$status_dir"
    temporary=$(mktemp "$status_dir/.status.XXXXXX")
    {
        printf 'state=%s\n' "$public_state"
        printf 'version=%s\n' "${update_state[version]}"
        printf 'candidate_slot=%s\n' "${update_state[candidate_slot]}"
        if [ "$public_state" = fallback ] && reason=$(refusal_reason 2>/dev/null); then
            printf 'refused_reason=%s\n' "$reason"
        fi
    } > "$temporary"
    chmod 0644 "$temporary"
    mv -f "$temporary" "$status_file"
}

[ -n "$health_units" ] || die 'AB_HEALTH_UNITS is empty; refusing to commit on a health check that asserts nothing'
is_positive_integer "$settle_seconds" || die 'commit settle interval is invalid'
is_positive_integer "$wait_seconds" || die 'commit readiness wait interval is invalid'
case "$on_refusal" in reboot|stay) ;; *) die "AB_ON_REFUSAL must be reboot or stay, not '$on_refusal'" ;; esac
[ -f "$state_file" ] && [ ! -L "$state_file" ] || exit 0
load_state || { printf '%s\n' '[ERROR] ignoring malformed update state' >&2; exit 0; }
case "${update_state[state]}" in
    committed) publish_status committed; exit 0 ;;
    fallback) publish_status fallback; exit 0 ;;
esac

[ -x "$selector" ] || die 'slot selector is unavailable'
if ! is_tryboot_candidate; then
    current_slot=$("$selector" current-slot) || exit 0
    if [ "$current_slot" != "${update_state[candidate_slot]}" ]; then
        write_update_state fallback
        publish_status fallback
    elif [ "$("$selector" normal-slot 2>/dev/null || true)" = "$current_slot" ]; then
        # Running the candidate on a normal boot, and the normal selector boots
        # it: it was committed out of band (by hand, or by a commit whose
        # record was lost). Record what the boot selector already says.
        write_update_state committed
        publish_status committed
        printf '[INFO] candidate slot %s is the normal boot slot; recorded as committed\n' "$current_slot"
    else
        publish_status candidate-armed
    fi
    exit 0
fi
current_slot=$("$selector" current-slot) || give_up 'the slot selector cannot name the running slot'
[ "$current_slot" = "${update_state[candidate_slot]}" ] || \
    give_up "this tryboot is running slot $current_slot, not the candidate"
publish_status candidate-armed

# Refuse any restart of a health unit from this candidate boot, including one
# that happens before the hook makes the normal readiness predicate true.
restarts=$(restart_counts) || give_up 'the restart counts of the health units are unreadable'
for pair in $restarts; do
    [ "${pair#*=}" = 0 ] || give_up "health unit ${pair%%=*} has already restarted (${pair#*=})"
done
deadline=$(( $(monotonic_seconds) + wait_seconds ))
while ! candidate_is_healthy "$restarts"; do
    [ "$(monotonic_seconds)" -lt "$deadline" ] || \
        give_up "not healthy within ${wait_seconds} s: $(health_failure "$restarts")"
    sleep 1
done
for _ in $(seq 1 "$settle_seconds"); do
    candidate_is_healthy "$restarts" || give_up "health lost in the settle window: $(health_failure "$restarts")"
    sleep 1
done
candidate_is_healthy "$restarts" || give_up "health lost at the end of the settle window: $(health_failure "$restarts")"

"$selector" commit "$current_slot"
write_update_state committed
publish_status committed
printf '[SUCCESS] committed candidate slot %s after %s seconds of health\n' "$current_slot" "$settle_seconds"
