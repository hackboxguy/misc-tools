#!/bin/bash
# pi-ab-update: request a factory reset.
#
# This does not wipe anything. It writes one root-owned marker and reboots; the
# early-boot service does the work, before any consumer of /data has started.
# Doing it that way is what makes the reset safe to interrupt: the marker
# survives a power cut, so an incomplete wipe simply runs again on the next
# boot rather than leaving half a device.
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

ab_config=${AB_UPDATE_CONFIG:-/usr/lib/pi-ab-update/ab-update.conf}

ab_config_value() { # $1=key; empty when absent
    [ -f "$ab_config" ] && [ ! -L "$ab_config" ] || return 0
    awk -v key="$1" '
        /^[[:space:]]*#/ { next }
        index($0, key "=") == 1 {
            value = substr($0, length(key) + 2)
            if (value != "") { print value; found = 1 }
        }
        END { exit !found }
    ' "$ab_config" 2>/dev/null || true
}
ab_setting() { # $1=env value, $2=config key, $3=default
    if [ -n "$1" ]; then printf '%s\n' "$1"; return; fi
    local configured; configured=$(ab_config_value "$2")
    if [ -n "$configured" ]; then printf '%s\n' "$configured"; return; fi
    printf '%s\n' "$3"
}

product=$(ab_setting "${AB_PRODUCT:-}" AB_PRODUCT pi-ab-update)
state_dir=$(ab_setting "${AB_STATE_DIR:-}" AB_STATE_DIR /data/pi-ab-update)
# Named here only so the confirmation can say what it is about to erase; the
# wipe itself is the boot service's, and resolves this the same way.
data_mount=$(ab_setting "${AB_DATA_MOUNT:-}" AB_DATA_MOUNT /data)
marker=${AB_RESET_MARKER:-$state_dir/factory-reset-requested}
reboot_command=${AB_REBOOT_COMMAND:-/usr/sbin/reboot}
# Rebooting immediately kills the caller before it can be told the request
# succeeded: a broker-mediated UI sees its connection die mid-reply and reports
# a failure for an operation that has in fact already been scheduled. Give the
# reply a moment to land. Set to 0 for a synchronous reboot (fixtures do).
reboot_delay=$(ab_setting "${AB_REBOOT_DELAY_SECONDS:-}" AB_REBOOT_DELAY_SECONDS 2)

log_diagnostic() {
    printf '[ERROR] %s\n' "$*" >&2
    command -v logger >/dev/null 2>&1 && \
        logger -t "ab-factory-reset[$product]" -p daemon.err -- "$*" || true
}
die() { log_diagnostic "$*"; exit 1; }

# One flag, and only one: --yes skips the interactive confirmation below.
# Anything else is still refused outright, because every other word a caller
# might pass here is a word this tool does not have.
assume_yes=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --yes|-y) assume_yes=1; shift ;;
        *) printf '%s\n' '[ERROR] factory reset accepts no arguments' >&2; exit 64 ;;
    esac
done
[ "$(id -u)" -eq 0 ] || die 'factory reset must run as root'
[ -x "$reboot_command" ] || die 'reboot command is unavailable'

# A person at a root shell gets one chance to change their mind.
#
# The panel gates this behind a PIN and two deliberate presses, and the broker
# is reached only through that UI - but this tool sits in root's PATH and used
# to erase the device with one command and no question. A reviewer proved the
# gap by running it on the bench, expecting a refusal that did not apply, and
# the owner's Wi-Fi credential went with it.
#
# Only when someone is there to answer: the broker has no terminal, fixtures
# have no terminal, and neither is asked. Root can always bypass a seatbelt;
# this one is against habit, not against intent.
if [ "$assume_yes" -eq 0 ] && [ -t 0 ]; then
    printf 'This erases all settings, credentials and identity on %s.\n' "$data_mount"
    printf 'The device restarts and comes back as if freshly flashed.\n'
    printf 'Type "erase" to continue: '
    read -r answer || answer=''
    [ "$answer" = erase ] || {
        printf '%s\n' '[ERROR] factory reset cancelled; nothing was erased' >&2
        exit 1
    }
fi

# Refuse while an update is on trial.
#
# A tryboot candidate gets exactly one boot, and this request spends it: the
# reset reboots for its own reasons, so the candidate never gets the boot it
# was armed for. Worse, the wipe erases the record that a candidate was being
# tried at all, so the commit service finds nothing to commit and the device
# falls back to the slot it came from. An update that was downloaded, written,
# signed-checked and booted is discarded without a word, and the reset then
# runs on the old image.
#
# That is not hypothetical. On the bench an owner updated and reset
# immediately, and got the old version back - along with the defect the update
# had just fixed, which made the fix look like it had not worked.
#
# The way out is always available and needs no flag: let the candidate commit,
# or reboot once to let it fall back. Either leaves a state this refuses on.
#
# Only an armed candidate is refused. A reset requested while an update is
# still *writing* is accepted, deliberately: the half-written slot is the
# inactive one, which is exactly the state a power cut leaves behind and which
# the next install overwrites from the start. The asymmetry is between "an
# update is waiting to be judged" and "an update is being written", and only
# the first has something to lose.
update_state_file=$state_dir/update-state
if [ -f "$update_state_file" ] && [ ! -L "$update_state_file" ]; then
    pending_state=$(awk -F= '$1 == "state" { print $2; exit }' "$update_state_file" 2>/dev/null || true)
    if [ "$pending_state" = candidate-armed ]; then
        # 75 is EX_TEMPFAIL: "try again later", which is exactly the advice.
        # A distinct code rather than a message, because the broker deliberately
        # never forwards handler output - the wording a person reads is authored
        # on the screen's side of the socket, and a code is what selects it.
        log_diagnostic 'an update is on trial; wait for it to finish, then reset'
        exit 75
    fi
fi

# The marker must land on the durable filesystem it is about to erase; if that
# is not writable there is nothing to reset and nothing would survive anyway.
install -d -m0700 -o root -g root "$state_dir" || die 'durable state directory is unavailable'
findmnt -rn -T "$state_dir" -o OPTIONS | grep -Eq '(^|,)rw(,|$)' || \
    die 'durable state is not mounted read-write'

# F-05: between writing the marker and scheduling the reboot there is a brief
# window where a caller can cancel us. The marker is already durable by then,
# so without this the reset would still happen next boot while the caller was
# told it had been cancelled. Withdraw it if we are interrupted before the
# reboot is committed to; once it is, the reset is going to happen and the
# marker must stay.
marker_written=0
withdraw_marker() {
    trap - HUP INT TERM
    [ "$marker_written" -eq 1 ] && rm -f -- "$marker" && sync -f "$state_dir" || true
    exit 1
}
trap withdraw_marker HUP INT TERM

temporary=$(mktemp "$state_dir/.factory-reset.XXXXXX")
printf 'requested=1\n' > "$temporary"
chmod 0600 "$temporary"
sync -f "$temporary"
mv -f "$temporary" "$marker"
sync -f "$state_dir"
marker_written=1

[[ $reboot_delay =~ ^[0-9]+$ ]] || die 'reboot delay must be a whole number of seconds'

# Past this point the reset is committed: cancelling must not withdraw it.
trap - HUP INT TERM

printf '[SUCCESS] factory reset requested; rebooting to perform it\n'
if [ "$reboot_delay" -eq 0 ]; then
    "$reboot_command"
else
    # Detached, so this process can exit and be reaped normally; the marker is
    # already durable, so nothing depends on this surviving. If the reboot
    # itself fails, say so in the journal: otherwise the device would sit with
    # a live marker and reset at whatever unrelated reboot came next, possibly
    # days later, surprising whoever performed it.
    setsid sh -c '
        sleep "$1"; shift
        product="$1"; shift
        "$@" && exit 0
        command -v logger >/dev/null 2>&1 &&             logger -t "ab-factory-reset[$product]" -p daemon.err --                 "scheduled reboot failed; the factory reset marker is still set and will run at the next boot"
    ' _ "$reboot_delay" "$product" "$reboot_command" >/dev/null 2>&1 < /dev/null &
fi
