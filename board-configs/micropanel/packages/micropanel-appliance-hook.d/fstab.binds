# micropanel A/B persistence: directories on /data bound over the paths the
# applications write. Appended to /etc/fstab by micropanel-appliance-hook.sh;
# the A/B finalizer keeps these lines (it replaces only the root, boot, data
# and NetworkManager mounts). Each bind waits for the factory reset and
# precedes its consumer; every consumer is in ab-update.conf AB_RESET_BEFORE.
# (Comments are safe here since pi-ab-update d7a3950; before it, the finalizer
# dropped a comment whose second word was a replaced mount point.)
# PERSISTENCE.md explains each one.
/data/micropanel-system/var-lib-micropanel /var/lib/micropanel none bind,nofail,x-systemd.requires=data.mount,x-systemd.after=ab-factory-reset.service,x-systemd.before=dip-switch-resolution.service 0 0
/data/disp-settings /var/lib/disp-settings none bind,nofail,x-systemd.requires=data.mount,x-systemd.after=ab-factory-reset.service,x-systemd.before=disp-settings-dual-display-restore.service 0 0
/data/kodi /home/pi/.kodi none bind,nofail,x-systemd.requires=data.mount,x-systemd.after=ab-factory-reset.service,x-systemd.before=micropanel.service 0 0
/data/disptool-results /home/pi/micropanel/share/disptool/display-test-framework/results none bind,nofail,x-systemd.requires=data.mount,x-systemd.after=ab-factory-reset.service,x-systemd.before=micropanel.service 0 0
/data/test-reports /home/pi/test-reports none bind,nofail,x-systemd.requires=data.mount,x-systemd.after=ab-factory-reset.service,x-systemd.before=qt-demo-launcher.service 0 0
