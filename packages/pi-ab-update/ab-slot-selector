#!/bin/bash
# pi-ab-update: minimal SD-card slot selector backend.
#
# Board-agnostic: the three-operation protocol (current-slot, arm-candidate,
# commit) is the seam the CM4 secure-boot backend replaces without touching the
# updater, the commit service, or any UI.
set -euo pipefail

ab_config=${AB_UPDATE_CONFIG:-/usr/lib/pi-ab-update/ab-update.conf}
ab_config_value() { # $1=key; empty when absent
    [ -f "$ab_config" ] && [ ! -L "$ab_config" ] || return 0
    awk -v key="$1" '
        /^[[:space:]]*#/ { next }
        index($0, key "=") == 1 {
            value = substr($0, length(key) + 2)
            if (value != "") { print value; found = 1 }
        }
        END { exit !found }
    ' "$ab_config" 2>/dev/null || true
}
ab_setting() { # $1=env value, $2=config key, $3=default
    if [ -n "$1" ]; then printf '%s\n' "$1"; return; fi
    local configured; configured=$(ab_config_value "$2")
    if [ -n "$configured" ]; then printf '%s\n' "$configured"; return; fi
    printf '%s\n' "$3"
}

boot_dir=$(ab_setting "${AB_BOOT_DIR:-}" AB_BOOT_DIR /boot/firmware)
template=$(ab_setting "${AB_BOOT_CONFIG_TEMPLATE:-}" AB_BOOT_CONFIG_TEMPLATE \
    /usr/lib/pi-ab-update/boot-selector-config.base)

# These render operations are intentionally identical today. Keeping separate
# names reserves candidate-only selector policy without changing the updater.

usage() {
    cat >&2 <<'EOF'
Usage: ab-slot-selector current-slot
       ab-slot-selector render-normal A|B
       ab-slot-selector render-candidate A|B
       ab-slot-selector arm-candidate A|B
       ab-slot-selector commit A|B
EOF
    exit 2
}

slot_arg() {
    case ${1:-} in
        A|B) printf '%s\n' "$1" ;;
        *) echo "ERROR: slot must be A or B" >&2; usage ;;
    esac
}

current_slot() {
    case " $(cat /proc/cmdline) " in
        *' root=LABEL=MP_ROOT_A '*) printf 'A\n' ;;
        *' root=LABEL=MP_ROOT_B '*) printf 'B\n' ;;
        *) echo "ERROR: active root is not an A/B slot" >&2; exit 1 ;;
    esac
}

render_config() { # $1=slot; render names intentionally remain separate protocol operations
    local slot=$1
    [ -r "$template" ] || { echo "ERROR: selector template unavailable: $template" >&2; exit 1; }
    # Both normal and one-shot selections use their complete, independently
    # updated os_prefix boot tree. Pi 4 hardware acceptance covers normal A
    # as well as tryboot B, so no flat-A compatibility path remains.
    # MP_ROOT_* labels stay as the fixed cross-board layout contract.
    printf 'os_prefix=%s/\n' "$slot"
    cat "$template"
}

boot_remounted_rw=0
temporary_path=""
restore_boot_state() {
    local status=$?
    # V5-01: the signal traps otherwise re-enter this function through EXIT.
    # Disarm them first so the remount and temp-file removal run exactly once.
    trap - EXIT HUP INT TERM
    if [ -n "$temporary_path" ]; then
        rm -f "$temporary_path" || true
    fi
    if [ "$boot_remounted_rw" = 1 ]; then
        mount -o remount,ro "$boot_dir" || true
    fi
    exit "$status"
}

make_boot_writable() {
    [ -d "$boot_dir" ] || { echo "ERROR: boot directory missing: $boot_dir" >&2; exit 1; }
    mountpoint -q "$boot_dir" || { echo "ERROR: boot directory is not mounted: $boot_dir" >&2; exit 1; }
    if ! findmnt -no OPTIONS -T "$boot_dir" | grep -Eq '(^|,)rw(,|$)'; then
        mount -o remount,rw "$boot_dir"
        boot_remounted_rw=1
    fi
    trap restore_boot_state EXIT HUP INT TERM
}

replace_config() { # $1=destination $2=slot $3=normal
    local destination=$1 slot=$2 normal=$3
    temporary_path=$(mktemp "$boot_dir/.${destination}.XXXXXX")
    render_config "$slot" "$normal" > "$temporary_path"
    sync "$temporary_path"
    mv -f "$temporary_path" "$boot_dir/$destination"
    temporary_path=""
    sync "$boot_dir/$destination"
    # FAT has no directory fsync interface; a final whole-system sync commits
    # the rename's directory entry before a subsequent selector write.
    sync
}

[ "$#" -ge 1 ] || usage
case "$1" in
    current-slot)
        [ "$#" -eq 1 ] || usage
        current_slot
        ;;
    render-normal)
        [ "$#" -eq 2 ] || usage
        render_config "$(slot_arg "$2")" 1
        ;;
    render-candidate)
        [ "$#" -eq 2 ] || usage
        render_config "$(slot_arg "$2")" 0
        ;;
    arm-candidate)
        [ "$#" -eq 2 ] || usage
        candidate=$(slot_arg "$2")
        [ "$(current_slot)" != "$candidate" ] || {
            echo "ERROR: refusing to arm the currently running slot $candidate" >&2
            exit 1
        }
        make_boot_writable
        replace_config tryboot.txt "$candidate" 0
        ;;
    commit)
        [ "$#" -eq 2 ] || usage
        selected=$(slot_arg "$2")
        [ "$(current_slot)" = "$selected" ] || {
            echo "ERROR: refusing to commit inactive slot $selected" >&2
            exit 1
        }
        if [ "$selected" = A ]; then other=B; else other=A; fi
        make_boot_writable
        # Preserve a complete fallback selector before changing the default.
        replace_config tryboot.txt "$other" 0
        replace_config config.txt "$selected" 1
        ;;
    *) usage ;;
esac
